# Server-only variables. Copy to server/.env (git-ignored) for local runs; on Render they are set in the dashboard
# or by render.yaml (keys only, values never in the repo). Nothing here may ever start with VITE_.

# --- database (Render Postgres; render.yaml wires this up automatically)
DATABASE_URL=
# true when using Render's EXTERNAL database URL from your own machine (internal URL needs no SSL)
DATABASE_SSL=false

# --- web service
NODE_ENV=development
PORT=3000
# Browser origins allowed to call the API, comma separated (exact, no trailing slash)
APP_ORIGIN=http://localhost:5174
# Public URL of the website; used in the links inside emails
APP_URL=http://localhost:5174

# --- auth
# Long random string that signs login cookies. Rotating it signs everyone out.
JWT_SECRET=
# bcrypt cost for new passwords (existing Supabase hashes keep working whatever this is)
BCRYPT_ROUNDS=10

# --- email (Resend, https://resend.com): verification and password-reset emails
RESEND_API_KEY=
# Must be on a domain verified in Resend, e.g. YOLO Nest <no-reply@yourdomain.com>
MAIL_FROM=
# true = print emails to the log instead of sending (local dev only)
MAIL_DRY_RUN=true

# --- file storage (Cloudflare R2, S3 API). STORAGE_DRIVER=local keeps files on disk for local runs only
STORAGE_DRIVER=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_DOCUMENTS_BUCKET=
R2_ROOM_IMAGES_BUCKET=
# Public base URL of the room-images bucket
R2_PUBLIC_URL=

# --- payments (Razorpay; start with test keys rzp_test_...)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
