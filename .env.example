# Copy to .env.local and fill in. Only public values go here: Vite ships every VITE_ variable to the browser.
# Find both in the Supabase dashboard (Project settings > API), or from `supabase status` when running locally.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# demo = simulated payments (no real money). razorpay = real payments; its secrets live in Supabase, not here (docs/payments.md)
VITE_PAYMENT_PROVIDER=demo
